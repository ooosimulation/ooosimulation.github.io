<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OOOsimulation - Discord Game</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

  <style>
    /* 화면 전체를 까만색으로 채우고 스크롤바 없애기 */
    body {
      margin: 0;
      padding: 0;
      background-color: #000;
      font-family: 'Press Start 2P', cursive;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    /* 게임 화면이 디스코드 창 중앙에 오도록 크기 조정 */
    #gameWrapper { 
      width: 100%; 
      max-width: 550px; /* 원래 지정하신 최대 크기 */
      background-color: #000;
      border: 4px solid #FFF; 
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(255,255,255,0.15);
      position: relative;
    }

    /* 기존에 작성하신 게임 전용 CSS 그대로 가져오기 */
    #titleBar { width: 100%; display: flex; justify-content: space-around; align-items: center; background-color: #000; padding: 15px 0; border-bottom: 2px solid #555; letter-spacing: 1px; }
    .title-left { font-size: 18px; color: #22CC44; text-shadow: 2px 2px 0 #000; } 
    .title-vs { font-size: 14px; color: #FFFFFF; }
    .title-right { font-size: 18px; color: #88CCFF; text-shadow: 2px 2px 0 #000; } 
    #gameCanvas { background-color: #000; display: block; width: 100%; height: auto; aspect-ratio: 1/1; cursor: crosshair; border: none; }
    #statusBar { width: 100%; padding: 15px 10px 10px; border-top: 2px solid #555; color: #FFF; text-align: center; display: flex; flex-direction: column; line-height: 1.5; box-sizing: border-box; }
    .status-hp { font-size: 11px; margin-bottom: 5px; text-shadow: 1px 1px 0 #000; }
    .status-effects { font-size: 9px; color: #CCC; }
    #startOverlay { position: absolute; top: 60px; left: 0; width: 100%; height: calc(100% - 115px); background-color: rgba(0, 0, 0, 0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; cursor: pointer; }
    .start-text { color: #FFF; font-size: 18px; text-align: center; line-height: 1.5; }
    .start-sub { color: #BBB; font-size: 12px; margin-top: 20px; text-align: center; }
    .controls-info { color: #AAFFAA; font-size: 12px; margin-top: 30px; line-height: 2; background-color: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; }

    @media (max-width: 768px) {
      .title-left, .title-right { font-size: 14px; }
      .start-text { font-size: 14px; }
      .controls-info { font-size: 9px; }
    }
  </style>

  <script type="module">
    import { DiscordSDK } from "https://esm.sh/@discord/embedded-app-sdk";
    const discordSdk = new DiscordSDK("여기에_복사한_Application_ID_입력");
    async function setupDiscord() {
      await discordSdk.ready();
    }
    setupDiscord();
  </script>
</head>
<body>

  <div id="gameWrapper">
    <div id="titleBar">
        <div class="title-left">STICK (YOU)</div>
        <div class="title-vs">VS</div>
        <div class="title-right">ANGLER (CPU)</div>
    </div>
    <div id="startOverlay">
        <div class="start-text">CLICK TO START</div>
        <div class="start-sub">Stick VS Angler</div>
        <div class="controls-info">[WASD]: Move<br><br>[J]: Auto-Charge Attack</div>
    </div>
    <canvas id="gameCanvas" width="550" height="550"></canvas>
    <div id="statusBar"></div>
  </div>

  <script>
    // ==========================================
    // 여기에 원래 파일의 // ===== GAME SCRIPT ===== 
    // 아래쪽 자바스크립트 코드를 그대로 전부 붙여넣으세요!
    // ==========================================
  </script>
</body>
</html>
